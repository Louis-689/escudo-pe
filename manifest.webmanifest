{
  "name": "Escudo – bitácora contra la extorsión",
  "short_name": "Escudo",
  "description": "Registra amenazas de extorsión, protege tus pruebas y prepara tu denuncia. Funciona sin internet.",
  "lang": "es-PE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f5",
  "theme_color": "#14532d",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivos",
          "accept": [
            "text/plain",
            "application/zip",
            ".txt",
            ".zip",
            "image/*",
            "audio/*",
            "video/*",
            "application/pdf"
          ]
        }
      ]
    }
  }
}
